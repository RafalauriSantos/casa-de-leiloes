# Backend (Vercel project settings in production; `make dev` and `make test` fill these from the local Supabase stack)
DATABASE_URL=            # Supabase transaction pooler (port 6543) in production, with ?sslmode=require
SUPABASE_URL=            # https://<project-ref>.supabase.co
AUDIT_HMAC_SECRET=       # >= 32 random chars; outside the database; rotating it makes every existing bid chain look tampered
CRON_SECRET=             # >= 16 random chars; the same value is stored in Supabase Vault for the per-minute job

# Frontend (public by design: the publishable/anon key only talks to Supabase Auth)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
