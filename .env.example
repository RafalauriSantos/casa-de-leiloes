# Backend (Vercel project settings in production; `make dev` and `make test` fill these from the local Supabase stack)
DATABASE_URL=            # Supabase transaction pooler (port 6543) in production, with ?sslmode=require
SUPABASE_URL=            # https://<project-ref>.supabase.co
AUDIT_HMAC_SECRET=       # >= 32 random chars; outside the database; rotating it makes every existing bid chain look tampered
CRON_SECRET=             # >= 16 random chars; the same value is stored in Supabase Vault for the per-minute job

# Frontend (public by design: the publishable/anon key only talks to Supabase Auth)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public catalog API (optional; the default is the Met). Tests point it at a local stub.
MET_API_URL=https://collectionapi.metmuseum.org/public/collection

# Public anchor of the bid-chain head (D21). The mode is required: `github` in production, `off` locally.
ANCHOR_MODE=             # github | off
ANCHOR_GITHUB_REPO=      # owner/repo of the public anchor repository (required when the mode is github)
ANCHOR_GITHUB_TOKEN=     # fine-grained token, Contents: read and write, that repository only (required when the mode is github; mark it Sensitive)
ANCHOR_GITHUB_BRANCH=main
ANCHOR_GITHUB_API_URL=https://api.github.com
